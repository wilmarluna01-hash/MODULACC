rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields:
    //   - id: string (required, immutable) - The unique identifier for the user.
    //   - email: string (required, format: email) - User's email address.
    //   - name: string (optional) - User's full name.
    //   - role: string (required, enum: ["student", "admin", "tutor"]) - User's role in the platform.
    //   - createdAt: string (optional, format: date-time) - When the user account was created.
    //
    // Collection: progress
    // Document ID: progressId
    // Fields:
    //   - userId: string (required) - The ID of the user.
    //   - moduleId: string (required) - The ID of the module.
    //   - score: number (required) - The score achieved in the module.
    //   - completedAt: string (optional, format: date-time) - When the module was completed.
    //
    // Collection: forum_posts
    // Document ID: postId
    // Fields:
    //   - authorId: string (required, immutable) - ID of the user who created the post.
    //   - authorName: string (required) - Name of the user who created the post.
    //   - title: string (required) - Title of the post.
    //   - content: string (required) - Content of the post.
    //   - category: string (required, enum: ["General", "Ciencias", "Historia", "Matemáticas", "Tecnología"]) - Category of the post.
    //   - createdAt: string (required, format: date-time) - When the post was created.
    //   - replies: list (optional) - List of replies to the post.
    //
    // Collection: exercises
    // Document ID: exerciseId
    // Fields:
    //   - id: string (optional) - Unique identifier.
    //   - moduleId: string (required, enum: ["science", "history", "math", "technology"]) - Module ID.
    //   - title: string (required) - Title of the exercise.
    //   - content: string (optional) - Text content for the exercise.
    //   - instruction: string (required) - Instructions for the student.
    //   - possibleAnswers: list (optional) - Multiple choice options.
    //   - correctAnswer: string (optional) - Correct answer for auto-grading.
    //   - explanation: string (optional) - Explanation for the answer.
    //   - order: number (optional) - Display order.
    //   - createdAt: string (required, format: date-time) - Creation timestamp.
    //   - authorId: string (required) - ID of the admin who created it.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.email == "wilmarluna01@gmail.com" ||
          request.auth.token.email == "wilson123@gmail.com");
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
             data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() < 256 &&
             data.role in ['student', 'admin', 'tutor'] &&
             (!('name' in data) || (data.name is string && data.name.size() < 100));
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'moduleId']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.moduleId is string && data.moduleId.size() < 100 &&
             (!('score' in data) || data.score is number) &&
             (!('timestamp' in data) || data.timestamp is timestamp);
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'title', 'content', 'category', 'createdAt']) &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.category in ["General", "Ciencias", "Historia", "Matemáticas", "Tecnología"] &&
             (!('replies' in data) || data.replies is list);
    }

    function isValidExercise(data) {
      return data.keys().hasAll(['moduleId', 'title', 'instruction', 'createdAt', 'authorId']) &&
             data.moduleId in ["science", "history", "math", "technology", "auditory-attention", "auditory-memory", "auditory-survey"] &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.instruction is string && data.instruction.size() > 0 && data.instruction.size() < 1000 &&
             data.authorId is string && 
             (!('content' in data) || (data.content is string && data.content.size() < 5000)) &&
             (!('possibleAnswers' in data) || data.possibleAnswers is list) &&
             (!('correctAnswer' in data) || data.correctAnswer is string) &&
             (!('explanation' in data) || data.explanation is string) &&
             (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() < 2000000)) &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() < 512)) &&
             (!('order' in data) || data.order is number) &&
             (!('exerciseType' in data) || data.exerciseType is string) &&
             (!('difficulty' in data) || data.difficulty is number) &&
             (!('audioConfig' in data) || data.audioConfig is map);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can read their own profile, admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile with 'student' role, admins can create any profile
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && 
                    ((isOwner(userId) && request.resource.data.role == 'student') || isAdmin());
      
      // Users can update their own profile (but not their role), admins can update any profile
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && 
                    ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      // Users can read their own progress, admins can read any progress
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create their own progress records
      allow create: if isAuthenticated() && isValidProgress(request.resource.data);
      
      // Users can update their own progress records
      allow update: if isAuthenticated() && isValidProgress(request.resource.data) && resource.data.userId == request.auth.uid;
      
      // Only admins can delete progress records
      allow delete: if isAdmin();
    }

    match /forum_posts/{postId} {
      // All authenticated users can read forum posts
      allow read: if isAuthenticated();
      
      // All authenticated users can create forum posts
      allow create: if isAuthenticated() && isValidForumPost(request.resource.data);
      
      // Only the author or an admin can update or delete a post
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin()) && isValidForumPost(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /exercises/{exerciseId} {
      // All authenticated users can read exercises
      allow read: if isAuthenticated();
      
      // Only admins can create, update, or delete exercises
      allow create: if isAdmin() && isValidExercise(request.resource.data);
      allow update: if isAdmin() && isValidExercise(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
